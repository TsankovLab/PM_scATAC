#!/bin/bash
# STAR alignment and gene counts of the NR4A2 enhancer CRISPRa experiment (Jurkat): NR4A2_1, NR4A2_2 (NR4A2 enhancer guides), SCRAMBLE_1-3 (scramble guides).
# One array task per sample: FastQC, then STAR 2.7.11b (index of 01_star_index.lsf, hg38 + GENCODE v46) with --quantMode GeneCounts.
# Output: <COUNTS_OUT>/<sample>_ReadsPerGene.out.tab (input of 00_nr4a2_count_matrix.R), <LOG_OUT>/<sample>_Log.final.out, BAMs in <BAM_OUT>/<sample>/
#BSUB -P <LSF_ACCOUNT>
#BSUB -J "star_align_nr4a2[1-5]"
#BSUB -q premium
#BSUB -n 8
#BSUB -R "rusage[mem=5000] span[hosts=1]"
#BSUB -W 4:00
#BSUB -o logs/star_align_nr4a2.%J.%I.out
#BSUB -e logs/star_align_nr4a2.%J.%I.err
#BSUB -L /bin/bash

source "${MESO_CONFIG:-$(for d in "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" "$PWD"; do while [ ! -f "$d/config.sh" ] && [ "$d" != / ]; do d=$(dirname "$d"); done; [ -f "$d/config.sh" ] && { echo "$d/config.sh"; break; }; done)}"   # data / results / reference roots: see config.sh at the repo root
ml star/2.7.11b fastqc/0.12.1

SAMPLES=(NR4A2_1 NR4A2_2 SCRAMBLE_1 SCRAMBLE_2 SCRAMBLE_3)
FASTQ_DIR=${SCRATCH_DIR}/CROPseq_validation_bulkRNA/fastq_raw
INDEX=${SCRATCH_DIR}/CROPseq_validation_bulkRNA/work/star_index_hg38
BAM_OUT=${SCRATCH_DIR}/CROPseq_validation_bulkRNA/work/bam
COUNTS_OUT=${DATA_DIR}/CROPseq_validation_bulkRNA/processed/counts
LOG_OUT=${DATA_DIR}/CROPseq_validation_bulkRNA/processed/logs
QC_DIR=${DATA_DIR}/CROPseq_validation_bulkRNA/processed/qc

SID=${SAMPLES[$((LSB_JOBINDEX - 1))]}
R1=$(ls "$FASTQ_DIR"/${SID}_S*_L001_R1_001.fastq.gz); R2=$(ls "$FASTQ_DIR"/${SID}_S*_L001_R2_001.fastq.gz)
mkdir -p "$BAM_OUT/$SID" "$COUNTS_OUT" "$LOG_OUT" "$QC_DIR"
fastqc -t 8 -o "$QC_DIR" "$R1" "$R2"

cd "$BAM_OUT/$SID"
STAR \
  --runThreadN 8 \
  --genomeDir "$INDEX" \
  --readFilesIn "$R1" "$R2" \
  --readFilesCommand zcat \
  --outSAMtype BAM SortedByCoordinate \
  --quantMode GeneCounts \
  --outFileNamePrefix "$BAM_OUT/$SID/${SID}_" \
  --outSAMunmapped Within

cp "$BAM_OUT/$SID/${SID}_ReadsPerGene.out.tab" "$COUNTS_OUT/"
cp "$BAM_OUT/$SID/${SID}_Log.final.out" "$LOG_OUT/"
