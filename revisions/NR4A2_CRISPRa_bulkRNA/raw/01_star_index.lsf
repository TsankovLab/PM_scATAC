#!/bin/bash
#BSUB -P <LSF_ACCOUNT>
#BSUB -J star_index_hg38
#BSUB -q express
#BSUB -n 32
#BSUB -R "rusage[mem=4000] span[hosts=1]"
#BSUB -W 12:00
#BSUB -o logs/star_index.%J.out
#BSUB -e logs/star_index.%J.err
#BSUB -L /bin/bash

source "${MESO_CONFIG:-$(for d in "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" "$PWD"; do while [ ! -f "$d/config.sh" ] && [ "$d" != / ]; do d=$(dirname "$d"); done; [ -f "$d/config.sh" ] && { echo "$d/config.sh"; break; }; done)}"   # data / results / reference roots: see config.sh at the repo root
ml star/2.7.11b

GENOME_FA=${GENOME_DIR}/human/hg38.fa
GTF=${GENOME_DIR}/human/gencode.v46.annotation.gtf
OUT=${SCRATCH_DIR}/CROPseq_validation_bulkRNA/work/star_index_hg38

STAR \
  --runMode genomeGenerate \
  --runThreadN 32 \
  --genomeDir "$OUT" \
  --genomeFastaFiles "$GENOME_FA" \
  --sjdbGTFfile "$GTF" \
  --sjdbOverhang 150
